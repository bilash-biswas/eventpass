# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://eventpass:eventpass_secret@localhost:5432/eventpass_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="eventpass_super_secret_jwt_access_key_min_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="eventpass_super_secret_jwt_refresh_key_min_32_characters"
JWT_REFRESH_EXPIRATION_DAYS=7

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
